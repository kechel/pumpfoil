# Connect-IQ-Build-Konfiguration.
project.manifest = manifest.xml

# Server-Basis-URL für Uploads. Pro Build überschreibbar, z. B.:
#   monkeyc ... -D base_url="https://pumpfoil.org"
base.sourcePath = source
base.resourcePath = resources

# --- Build-Varianten (Speicher): DREI Stufen ---
# Drei unabhängige Annotations-Paare, damit jede Stufe genau das wegnimmt, was sie muss:
#   Menüs    `(:full)`      <-> `(:lite)`        Pausen-Menü, Aktions-Menü
#   Layouts  `(:layouts)`   <-> `(:nolayouts)`   dynamischer Renderer + Layout-Canary
#   Sprachen `(:i18n)`      <-> `(:noi18n)`      13-Sprachen-Tabelle vs. English-only
#   Farbe    `(:farbig)`    <-> `(:mono)`        Akzentfarben vs. alles weiss (1-Bit-Displays,
#                                               Liste aus dem SDK, geprueft von check-mono.py)
#   GPS      `(:gpsvoll)`   <-> `(:gpssparen)`  GPS nur um bewegte Abschnitte speichern (nur ohne
#                                               Accel): 96-KB-Uhren + die 128-KB-Mittelklasse (Jan 09.10.2026),
#                                               je Uhr abschaltbar (gpsSparen aus /config)
#   Mittel   `(:klassik)`   <-> `(:nichtklassik)` Seitenaufteilung mit Nebendisplay (nur 128 KB)
#   Klassik  `(:klassik)`                        klassische Seiten-Saetze + „alle Seiten" OHNE Layout-
#                                               Renderer — NUR Mittelklasse (VOLL und LITE schliessen
#                                               es aus; LITE ist am Limit, Jan 25.09.2026)
#
# VOLL (>= 512 KB, ~100 Geräte): alles an.
base.excludeAnnotations = lite;nolayouts;noi18n;klassik;mono;gpssparen
#
# LITE (96 KB, Instinct-2-Klasse): alles Schwere raus. Siehe memory garmin-instinct2-lowmem.
instinct2.excludeAnnotations = full;layouts;i18n;klassik;farbig;gpsvoll
instinct2s.excludeAnnotations = full;layouts;i18n;klassik;farbig;gpsvoll
instinct2x.excludeAnnotations = full;layouts;i18n;klassik;farbig;gpsvoll
instinctcrossover.excludeAnnotations = full;layouts;i18n;klassik;farbig;gpsvoll
descentg1.excludeAnnotations = full;layouts;i18n;klassik;farbig;gpsvoll
#
# ENG (128 KB, 16 Geräte) — NEU 17.08., Anlass war ein gemessener stiller Totalausfall:
# diese Klasse fährt den VOLLEN Build und ist mit ihm aus dem Speicher gewachsen. Gemessen an
# der FR55: 1.0.60 = 58 508 B (72 564 B frei) -> 1.0.77 = 105 052 B (nur noch 26 020 B frei).
# Belegt an Geraet #136 (dieselbe Uhr: auf 1.0.60 noch brauchbar, auf 1.0.76 sechs Totalausfälle);
# von 7 aktiv gepairten Uhren dieser Klasse hatten 4 nie eine einzige Session. Details docs/TODO.md.
# Weggenommen wird nur, was hier ohnehin kaum trägt: der Layout-Renderer (dieser Klasse liefert
# der Server Layouts nur auf ausdrückliche Anforderung) und die 13-Sprachen-Tabelle (-> Englisch).
# Die MENÜS bleiben — das ist der Unterschied zu LITE.
venusq.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
enduro.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fenix6.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fenix6s.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fr245.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fr645.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fr935.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fenix5.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fenix5s.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fr55.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
vivoactive3.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
vivoactive3d.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
fenixchronos.excludeAnnotations = lite;layouts;i18n;nichtklassik;mono;gpsvoll
instinct3solar45mm.excludeAnnotations = lite;layouts;i18n;nichtklassik;farbig;gpsvoll
instincte45mm.excludeAnnotations = lite;layouts;i18n;nichtklassik;farbig;gpsvoll
instincte40mm.excludeAnnotations = lite;layouts;i18n;nichtklassik;farbig;gpsvoll
