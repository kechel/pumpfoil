<stack class="wurzel">
    <!-- Krone bildschirmgross unter der Anzeige, s. index.hml (Pruefung 26.11.2026: 1-px-picker-view „not adapted"). -->
    <picker-view class="krone" ref="krone" type="text" range="{{ kroneWerte }}" selected="{{ kroneStand }}" onchange="krone"></picker-view>
<div class="seite" onswipe="wischen">
    <!-- Einstellungen auf der Uhr wie Zepp-Seite 4/4 (Jan, 08.10.2026). Eigene Seite = eigenes Buendel (die
         Startseite liegt an der 48-KB-Grenze).
         AppGallery-Pruefung 23.11.2026 (GT 6/Fit 5, Regel 3.1): aus der Liste kam man nur mit Rechtswischen zurueck,
         nicht mit der Krone oder Gegenwischen. Deshalb ein senkrechter Swiper statt der Liste: eine Einstellung je
         Seite (passt auch auf die schmale eckige Uhr), davor Seite 0 = Startseite. Wer zurueck auf Seite 0 wischt oder
         dreht, landet auf der Startseite — dieselbe Geste wie hinein, nur umgekehrt. Tippen schaltet weiter. -->
    <swiper class="blaetter" ref="blaetter" vertical="true" loop="false" index="{{ seite }}" onchange="blatt">
        <div class="blatt">
            <text class="marke">PUMPFOIL</text>
        </div>
        <div class="blatt" for="{{ eintraege }}" onclick="tippen">
            <text class="begriff">{{ $item.b }}</text>
            <text class="wert">{{ $item.z }}</text>
            <text class="nr">{{ $item.n }}</text>
        </div>
    </swiper>
</div>
</stack>
