<div class="seite" onswipe="wischen">
    <!-- Ablauf wie Zepp/Wear/Apple (Jan, 08.10.2026: „genauso von der benutzerfuehrung … wie bei
         anderen uhren"). Waehrend der Aufnahme eine Seitenfolge, hoch/runter gewischt:
           [Aktion] [STOPP] [Datenseiten …] [STOPP] [Aktion]   — Start auf der ersten Datenseite.
         Aktion = Pause/Fortsetzen (2 s halten) + Verwerfen (zweimal tippen); STOPP = 2 s halten,
         im Profil-Modus „press" ein Tipp. Rechts wischen: bereit -> App zu, Aufnahme -> STOPP-Seite. -->
    <canvas ref="leinwand" class="leinwand" if="{{ ansicht === 'daten' }}"></canvas>

    <!-- Bereit: START tippen, wie auf allen Uhren -->
    <div class="bbereit" if="{{ ansicht === 'bereit' }}">
        <text class="marke">PUMPFOIL</text>
        <div class="kstart" onclick="starten">
            <text class="knopftext">{{ tStart }}</text>
        </div>
        <progress class="balken" type="horizontal" percent="{{ balken }}" if="{{ balkenZeigen }}"></progress>
        <text class="klein">{{ info }}</text>
    </div>

    <!-- Aktion: Pause/Fortsetzen + Verwerfen. Halte-Knopf OHNE onclick: mit click am selben Element kam
         im Simulator kein touchstart an; longpress ist der Ersatz (s. index.js lang). -->
    <div class="baktion" if="{{ ansicht === 'aktion' }}">
        <text class="zeit">{{ zeit }}</text>
        <div class="kpause" if="{{ halten }}" ontouchstart="pauseHalten" ontouchend="loslassen" onlongpress="pauseLang">
            <text class="knopftext">{{ tPause }}</text>
        </div>
        <div class="kpause" if="{{ !halten }}" onclick="pauseTipp">
            <text class="knopftext">{{ tPause }}</text>
        </div>
        <div class="kweg" onclick="verwerfenTipp">
            <text class="knopftext">{{ tWeg }}</text>
        </div>
        <text class="klein">{{ info }}</text>
    </div>

    <!-- STOPP: Zeit, Strecke, roter Knopf -->
    <div class="bstopp" if="{{ ansicht === 'stopp' }}">
        <text class="zeit">{{ zeit }}</text>
        <text class="wertbreit">{{ strecke }}</text>
        <div class="kstopp" if="{{ halten }}" ontouchstart="stoppHalten" ontouchend="loslassen" onlongpress="stoppLang">
            <text class="knopftext">{{ tStopp }}</text>
        </div>
        <div class="kstopp" if="{{ !halten }}" onclick="stoppTipp">
            <text class="knopftext">{{ tStopp }}</text>
        </div>
        <text class="klein">{{ info }}</text>
    </div>
</div>
