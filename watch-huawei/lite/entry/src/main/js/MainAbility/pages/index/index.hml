<div class="seite" onswipe="wischen">
    <!-- Datenseiten (seiten.js): eine Canvas ueber das ganze Display, hoch/runter wischen blaettert
         (rechts wischen beendet die App, das verlangt AppGallery). Seite 0 = Bedienung darunter. -->
    <canvas ref="leinwand" class="leinwand" if="{{ datenseite }}"></canvas>
    <text class="marke" if="{{ !datenseite }}">PUMPFOIL</text>

    <div class="block" if="{{ modus === 'bereit' }}">
        <div class="kstart" ontouchstart="startHalten" ontouchend="loslassen">
            <text class="knopftext">{{ knopfStart }}</text>
        </div>
        <progress class="balken" type="horizontal" percent="{{ balken }}" if="{{ balkenZeigen }}"></progress>
        <text class="klein">{{ info }}</text>
    </div>

    <div class="block" if="{{ modus === 'laeuft' && !datenseite }}">
        <text class="zeit">{{ zeit }}</text>
        <div class="reihe">
            <text class="wert">{{ tempo }}</text>
            <text class="wert">{{ strecke }}</text>
        </div>
        <div class="reihe">
            <text class="einheit">km/h</text>
            <text class="einheit">km</text>
        </div>
        <text class="wert">{{ puls }}</text>
        <div class="kpause" ontouchstart="pauseHalten" ontouchend="loslassen">
            <text class="knopftext">{{ knopfPause }}</text>
        </div>
        <text class="klein">{{ info }}</text>
    </div>

    <div class="block" if="{{ modus === 'pause' && !datenseite }}">
        <text class="zeit">{{ zeit }}</text>
        <text class="hinweis">{{ textPause }}</text>
        <div class="reihe">
            <div class="kweiter" ontouchstart="weiterHalten" ontouchend="loslassen">
                <text class="knopftext">{{ knopfWeiter }}</text>
            </div>
            <div class="kstopp" ontouchstart="stoppHalten" ontouchend="loslassen">
                <text class="knopftext">{{ knopfStopp }}</text>
            </div>
        </div>
        <text class="klein">{{ info }}</text>
    </div>
</div>
