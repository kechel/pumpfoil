{
  "name": "Pumpfoil",
  "version": "1.00",
  "author": "pumpfoil.org",
  "description": "Runs, pumps and cadence on the watch; raw data to the Pumpfoil phone app",
  "type": "device",
  "usage": "workout",
  "modificationTime": 1792195200,
  "in": [
    {
      "name": "tmr",
      "source": "Activity/ActivityTimer",
      "type": "subscribe"
    },
    {
      "name": "sp",
      "source": "Activity/Current/Speed",
      "type": "subscribe"
    },
    {
      "name": "hr",
      "source": "Activity/Move/-1/HeartRate/Current",
      "type": "subscribe"
    },
    {
      "name": "pos",
      "source": "Fusion/Location/GeoCoordinates",
      "type": "subscribe"
    },
    {
      "name": "rdy",
      "source": "Fusion/Location/Readiness",
      "type": "subscribe"
    },
    {
      "name": "acc",
      "source": "Fusion/Zapp/Accelerometer",
      "type": "subscribe"
    },
    {
      "name": "utc",
      "source": "Dev/Time",
      "type": "subscribe"
    },
    {
      "name": "lt",
      "source": "Dev/Time/LocalTime/Min",
      "type": "subscribe"
    },
    {
      "name": "alt",
      "source": "Fusion/Altitude",
      "type": "subscribe"
    },
    {
      "name": "asc",
      "source": "Fusion/Altitude/Ascent",
      "type": "subscribe"
    }
  ],
  "out": [
    {
      "name": "con"
    },
    {
      "name": "pf_foil",
      "log": true,
      "shownName": "Pumpfoil run",
      "format": "Count_Threedigits"
    },
    {
      "name": "pf_p1",
      "log": true,
      "shownName": "Pump marker",
      "format": "Count_Fivedigits"
    },
    {
      "name": "pf_p2",
      "log": true,
      "shownName": "Pump marker 2",
      "format": "Count_Fivedigits"
    },
    {
      "name": "pf_int",
      "log": true,
      "shownName": "Motion [mg]",
      "format": "Count_Fourdigits"
    },
    {
      "name": "pf_peak",
      "log": true,
      "shownName": "Peak [mg]",
      "format": "Count_Fourdigits"
    },
    {
      "name": "pumps",
      "format": "Count_Fourdigits"
    },
    {
      "name": "laeufe",
      "format": "Count_Threedigits"
    }
  ],
  "template": [
    {
      "name": "d.html"
    }
  ],
  "settings": [
    {
      "shownName": "Raw data to phone app",
      "path": "handy",
      "type": "boolean"
    },
    {
      "shownName": "Raw data rate",
      "path": "hz",
      "type": "enum",
      "values": [
        "25 Hz",
        "50 Hz"
      ]
    },
    {
      "shownName": "Language",
      "path": "sprache",
      "type": "enum",
      "values": [
        "English",
        "Deutsch",
        "Schwiizerdütsch",
        "Österreichisch",
        "Français",
        "Italiano",
        "Español",
        "Português",
        "Bahasa Indonesia",
        "Русский",
        "Nederlands",
        "Suomi",
        "Čeština",
        "日本語",
        "中文"
      ]
    }
  ]
}
