# systemd-Unit für den FastAPI-Server auf der VM app-host.
# Installation:
#   sudo cp deploy/foil-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now foil-server
#
# Apache (the reverse proxy) proxied https://pumpfoil.org -> app-host:8090.
# Daher bind auf 0.0.0.0 (im internen Netz erreichbar), nicht nur localhost.

[Unit]
Description=Pump-Foil-Tracker FastAPI server
# Der lauschende Socket gehoert `foil-server.socket` und ueberlebt jeden Neustart dieses
# Dienstes — deshalb gibt es beim Update keine abgewiesene Verbindung mehr, nur eine kurze
# Wartezeit. Gemessen am 07.09.2026 an einem identischen Testpaar auf Port 8099: vorher
# 1,66 s „connection refused", danach 0 Abweisungen und eine Anfrage mit 1,97 s Wartezeit.
Requires=foil-server.socket
After=foil-server.socket network.target

[Service]
Type=simple
User=foil
WorkingDirectory=/opt/foil/garmin-connect-iq/server
EnvironmentFile=/opt/foil/garmin-connect-iq/server/.env
# --timeout-graceful-shutdown: beim Restart laufende Requests (v. a. Chunk-Uploads,
# sub-sekunde) noch fertig bedienen, bevor die Worker sterben -> Uploads werden vom
# Restart praktisch nie unterbrochen. TimeoutStopSec muss größer sein, sonst SIGKILLt
# systemd vor Ablauf der Drain-Zeit.
#
# 15 s, NICHT 300: mit der Socket-Aktivierung warten alle neuen Verbindungen in der
# Accept-Queue, solange der alte Prozess noch herunterfaehrt. Eine einzige haengende
# Anfrage wuerde bei 300 s also fuenf Minuten lang ALLE blockieren. Chunk-Uploads sind
# Millisekunden, 15 s reichen mit grossem Abstand.
ExecStart=/opt/foil/garmin-connect-iq/server/.venv/bin/uvicorn app.main:app --workers 4 --fd 3 --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-graceful-shutdown 15
Restart=on-failure
RestartSec=3
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
